# ==============================================================================
# SAFEGUARD AI - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your project URL and Anon Public Key from your Supabase Dashboard
#    (Project Settings -> API)
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public Key (safe for client-side queries protected by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
